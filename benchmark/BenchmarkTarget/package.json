{
  "name": "agentic-ai-benchmark-target",
  "version": "1.0.0",
  "description": "TypeScript benchmark target for experiments on adaptive orchestration of LLM-based agentic systems.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.public.config.ts",
    "test:public:t1": "vitest run --config vitest.public.t1.config.ts",
    "test:public:t2": "vitest run --config vitest.public.t2.config.ts",
    "test:public:t3": "vitest run --config vitest.public.t3.config.ts",
    "test:public:t4": "vitest run --config vitest.public.t4.config.ts",
    "test:public:t5": "vitest run --config vitest.public.t5.config.ts",
    "test:public:t6": "vitest run --config vitest.public.t6.config.ts --reporter=verbose"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
